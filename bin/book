#!/bin/sh
# Claude & Prejudice's local launcher: `book next`, `book back`, `book reader`,
# or `book "Pride and Prejudice"` from a terminal outside Claude Code.
#
# Resolve through symlinks so `book` can live anywhere on PATH.

set -u

target="$0"
hops=0
while [ -L "$target" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt 32 ]; then
        echo "book: too many symlink hops while resolving the entry point" >&2
        exit 1
    fi
    link=$(readlink "$target") || break
    case "$link" in
        /*) target="$link" ;;
        *) target="$(dirname "$target")/$link" ;;
    esac
done

root=$(cd "$(dirname "$target")/.." && pwd) || {
    echo "book: cannot resolve the Claude & Prejudice directory" >&2
    exit 1
}

THINKING_BOOK_COMMAND=book
export THINKING_BOOK_COMMAND
exec python3 "$root/scripts/thinking_book.py" "$@"
